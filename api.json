{
  "apiVersion": "1.0",
  "name": "xmlui-test-server-demo-api",
  "description": "Demo API for xmlui-test-server",
  "basePath": "/api",
  "endpoints": [
    {
      "path": "/sqlite",
      "methods": {
        "GET": {
          "description": "Report SQLite version",
          "sql": "select sqlite_version() as version"
        }
      }
    },
    {
      "path": "/postgres",
      "methods": {
        "GET": {
          "description": "Report Postgres version",
          "sql": "select version() as version"
        }
      }
    },
    {
      "path": "/query_from_file",
      "methods": {
        "GET": {
          "description": "Report Postgres version",
          "sqlFile": "query.sql"
        }
      }
    },
    {
      "path": "/entities/:entity",
      "methods": {
        "GET": {
          "description": "Get a list of entities",
          "sql": "SELECT * FROM :entity",
          "params": ["entity"]
        },
        "POST": {
          "description": "Create a new entity (dynamic INSERT based on JSON body)",
          "sql": "INSERT INTO :entity (columns) VALUES (values)",
          "params": ["entity"]
        }
      }
    },
    {
      "path": "/entities/:entity/:id",
      "methods": {
        "GET": {
          "description": "Get a single entity by ID",
          "sql": "SELECT * FROM :entity WHERE id = :id",
          "params": ["entity", "id"]
        }
      }
    }
  ]
}
